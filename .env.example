# Copy this file to ".env" in the project root and fill in your values.
# Never commit .env (it is gitignored).

SMTP_USER=info@webnovacrew.com
SMTP_PASS=paste-your-zoho-app-password-no-spaces

# Optional: LOGIN (default) vs PLAIN — Zoho usually works with LOGIN.
# SMTP_AUTH_METHOD=PLAIN
# Optional: 1 = do not try smtp.zoho.in or port 465 automatically.
# SMTP_NO_FALLBACK=1

# Optional — defaults: port 587 + STARTTLS (Zoho-friendly). For SSL on 465 instead:
# SMTP_PORT=465
# SMTP_SECURE=true
#
# If you see "535 Authentication Failed":
# - SMTP_USER must be the full mailbox email (e.g. info@yourdomain.com).
# - SMTP_PASS must be a Zoho Mail app password, pasted with no spaces.
# - Try SMTP_HOST=smtp.zoho.in if your org is on Zoho India.

# Optional — how the email appears in the inbox "From" line:
# CONTACT_FROM=Web Nova Crew <info@webnovacrew.com>
